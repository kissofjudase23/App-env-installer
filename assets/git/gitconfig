[core]
    # editor comes from $GIT_EDITOR / $VISUAL / $EDITOR
    # checkout as-is, commit unix style line endings
    autocrlf = input
    # show non-ASCII file names as-is
    quotepath = off
[color]
    ui = true
[init]
    defaultBranch = main
[alias]
    df = diff
    co = checkout
    ci = commit
    st = status
    br = branch
    d = difftool
    mg = merge
    ss = show --name-status
    ls = log --stat --decorate --abbrev-commit
    ll = log --graph --decorate --pretty=oneline --abbrev-commit
    li = log --oneline --name-status --no-merges
    lf = log --stat --decorate --format=fuller --abbrev-commit
    la = log --graph --decorate --abbrev-commit --all --pretty=format:'%C(yellow)%h%C(reset) %s %C(bold blue)<%an>%C(reset) %C(bold red)[%cd]%C(reset)%C(bold green)%d%C(reset)' --date=short
    lo = log --graph --decorate --abbrev-commit --all --pretty=format:'%C(yellow)%h%C(reset) %s %C(bold blue)<%an>%C(reset) %C(bold red)[%cd]%C(reset)%C(bold green)%d%C(reset)' --date=short --date-order
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
[diff]
    tool = vimdiff
    algorithm = histogram
[delta]
    # used when GIT_PAGER=delta (set by common.sh if delta is installed)
    navigate = true
    line-numbers = true
[difftool]
    prompt = false
[merge]
    tool = vimdiff
    # Even create extra merge commit when fast forward merge would be possible
    ff = false
    # zdiff3 needs git >= 2.35; Ubuntu 22.04 ships 2.34
    conflictStyle = diff3
[pull]
    rebase = true
[push]
    # git >= 2.37; older git ignores it
    autoSetupRemote = true
[fetch]
    prune = true
[rerere]
    enabled = true
[url "https://github.com/"]
    insteadOf = git://github.com/
# Machine-specific settings such as [user] name/email (created by install.py)
[include]
    path = ~/.gitconfig.local
